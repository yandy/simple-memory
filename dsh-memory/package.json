{
	"name": "@yandy0725/dsh-memory",
	"version": "0.0.0",
	"private": true,
	"description": "Memory bundle for @deepseek-ai/dsh (cordis): shares one on-disk memory with pi-memory.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/yandy/simple-memory",
		"directory": "dsh-memory"
	},
	"engines": {
		"node": ">=24.9.0",
		"dsh": ">=0.2.2-rc.1 <0.3.0"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./cordis.patch.yml": "./cordis.patch.yml",
		"./package.json": "./package.json"
	},
	"files": [
		"dist/",
		"src/",
		"cordis.patch.yml",
		"README.md",
		"README.zh.md",
		"LICENSE"
	],
	"dsh": {
		"manifestVersion": 1,
		"bundle": {
			"patch": "./cordis.patch.yml"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"format": "biome format --write ."
	},
	"dependencies": {
		"@yandy0725/memory-core": "^2.0.0"
	},
	"peerDependencies": {
		"@deepseek-ai/cordis": "~4.1.0",
		"@deepseek-ai/dsh-agent": ">=0.2.2-rc.1 <0.3.0",
		"@deepseek-ai/dsh-commands": ">=0.2.2-rc.1 <0.3.0",
		"@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.3.0",
		"@deepseek-ai/dsh-session": ">=0.2.2-rc.1 <0.3.0",
		"@deepseek-ai/dsh-session-query": ">=0.2.2-rc.1 <0.3.0",
		"@deepseek-ai/dsh-system-prompt": ">=0.2.2-rc.1 <0.3.0",
		"@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <0.3.0",
		"@deepseek-ai/dsh-working-directory": ">=0.2.2-rc.1 <0.3.0"
	},
	"peerDependenciesMeta": {
		"@deepseek-ai/cordis": {
			"optional": true
		},
		"@deepseek-ai/dsh-agent": {
			"optional": true
		},
		"@deepseek-ai/dsh-commands": {
			"optional": true
		},
		"@deepseek-ai/dsh-llm": {
			"optional": true
		},
		"@deepseek-ai/dsh-session": {
			"optional": true
		},
		"@deepseek-ai/dsh-session-query": {
			"optional": true
		},
		"@deepseek-ai/dsh-system-prompt": {
			"optional": true
		},
		"@deepseek-ai/dsh-tools": {
			"optional": true
		},
		"@deepseek-ai/dsh-working-directory": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/node": "^26.6.6",
		"typescript": "~7.0.2",
		"vitest": "^5.0.5",
		"@deepseek-ai/cordis": "4.1.0",
		"@deepseek-ai/dsh-agent": "0.2.2-rc.1",
		"@deepseek-ai/dsh-commands": "0.2.2-rc.1",
		"@deepseek-ai/dsh-llm": "0.2.2-rc.1",
		"@deepseek-ai/dsh-session": "0.2.2-rc.1",
		"@deepseek-ai/dsh-session-query": "0.2.2-rc.1",
		"@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
		"@deepseek-ai/dsh-tools": "0.2.2-rc.1",
		"@deepseek-ai/dsh-working-directory": "0.2.2-rc.1"
	}
}
