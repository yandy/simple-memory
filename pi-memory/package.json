{
	"name": "@yandy0725/pi-memory",
	"publishConfig": {
		"access": "public"
	},
	"version": "4.3.2",
	"description": "File-system driven persistent memory layer for pi coding agent",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/yandy/simple-memory",
		"directory": "pi-memory"
	},
	"type": "module",
	"dependencies": {
		"@yandy0725/memory-core": "^2.3.0"
	},
	"keywords": [
		"pi-package"
	],
	"files": [
		"index.ts",
		"src/",
		"LICENSE"
	],
	"scripts": {
		"prepack": "node ../scripts/sync-license.mjs",
		"postpack": "node ../scripts/sync-license.mjs --remove",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"format": "biome format --write ."
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": ">=1.5.0",
		"@earendil-works/pi-coding-agent": ">=1.5.0",
		"@earendil-works/pi-tui": ">=1.5.0",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.7",
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@earendil-works/pi-tui": "1.5.0",
		"@types/node": "^26.6.6",
		"typebox": "^1.4.7",
		"typescript": "~7.0.2",
		"vitest": "^5.0.5"
	}
}
