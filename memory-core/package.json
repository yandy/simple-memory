{
	"name": "@yandy0725/memory-core",
	"version": "2.0.1",
	"description": "Harness-agnostic file-system memory layer: one memory = one Markdown file, a MEMORY.md index, two-level locking, snapshots, and the LLM orchestration around them.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/yandy/simple-memory",
		"directory": "memory-core"
	},
	"type": "module",
	"engines": {
		"node": ">=20.16.0"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist/",
		"src/",
		"README.md",
		"README.zh.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"agent-memory",
		"memory",
		"harness-agnostic"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepublishOnly": "npm run build",
		"prepack": "node ../scripts/sync-license.mjs",
		"postpack": "node ../scripts/sync-license.mjs --remove",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"format": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/node": "^26.6.6",
		"typescript": "~7.0.2",
		"vitest": "^5.0.5"
	}
}
